# ---------------------------------------------------------------------------
# TaskFlow environment variables
# Copy this file to .env at the repository root and fill in real values.
# NEVER commit the real .env file or any real credentials.
# ---------------------------------------------------------------------------

# Flask runtime mode: development | production | testing
FLASK_ENV=development
FLASK_APP=run.py

# Backend server
HOST=0.0.0.0
PORT=5000

# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# Local MongoDB example:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=taskflow

# Generate a strong secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when FLASK_ENV=production.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_HOURS=24

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend only (used from frontend/.env, copy frontend/.env.example)
# VITE_API_BASE_URL=http://localhost:5000/api
